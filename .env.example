# Copy to .env and fill in. .env is gitignored; .env.example is committed and must never
# contain a real value.

# --- Database -------------------------------------------------------------------------------
# POSTGRES_PASSWORD has no default anywhere: the app and compose both refuse to start without it.
POSTGRES_DB=ledgerlens
POSTGRES_USER=ledgerlens
POSTGRES_PASSWORD=choose-a-password

# Only needed when the database is not the one compose starts. Running the backend on the host
# against the compose database works with the defaults below.
# POSTGRES_HOST=localhost
# POSTGRES_PORT=5432

# --- AI (optional) --------------------------------------------------------------------------
# Without this the app still starts and reconciles: only the classifier, the waterfall narration
# and the Ask panel return 503. https://aistudio.google.com/apikey
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-3.6-flash

# --- Razorpay (optional) --------------------------------------------------------------------
# Test-mode keys, for POST /api/ingest/razorpay only. CSV ingest never needs them.
# https://dashboard.razorpay.com/app/website-app-settings/api-keys
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# --- Paths and ports (optional) -------------------------------------------------------------
# Ground truth for GET /api/metrics/{batchId}. Compose mounts ./data read-only at /app/data.
# Leave unset outside Docker and it resolves to data/answer_key.json.
# LEDGERLENS_ANSWER_KEY_PATH=/app/data/answer_key.json
# BACKEND_PORT=8080
# FRONTEND_PORT=5173
